FLASK_ENV=production
# Optional: set SECRET_KEY to a random value of at least 32 characters.
# Optional: set JWT_SECRET_KEY to a different random value of at least 32 characters.
DATABASE_URL=sqlite:///field_manager.db
MAX_CONTENT_LENGTH=8388608
HOST=0.0.0.0
PORT=5000

# Without explicit secrets, private persistent random keys are generated in instance/security.json.
